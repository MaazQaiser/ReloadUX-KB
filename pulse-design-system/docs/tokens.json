{
  "$description": "ReloadUX · Pulse design tokens (W3C DTCG format). Same values as tokens.css. Import into Figma Tokens Studio, Style Dictionary, or any DTCG-aware tool.",
  "color": {
    "light": {
      "ink": { "$type": "color", "$value": "#090909", "$description": "Primary text; also the solid fill for buttons, user bubble, toggles" },
      "surface": { "$type": "color", "$value": "#ffffff", "$description": "Page and card background; also text on an ink fill" },
      "tint": { "$type": "color", "$value": "#f0f0f0", "$description": "Subtle fill: hover, composer field, answered card, zebra rows" },
      "hairline": { "$type": "color", "$value": "#d9d9d9", "$description": "All borders and dividers" },
      "muted": { "$type": "color", "$value": "#a5a9ac", "$description": "Captions, placeholders, status lines" },
      "accent": { "$type": "color", "$value": "#7f56d9", "$description": "Report structure only" },
      "accent-soft": { "$type": "color", "$value": "rgba(127, 86, 217, 0.15)" },
      "accent-faint": { "$type": "color", "$value": "rgba(127, 86, 217, 0.08)" },
      "secondary": { "$type": "color", "$value": "#565656", "$description": "Report body text" },
      "tertiary": { "$type": "color", "$value": "#a5a9ac", "$description": "Report labels, keys, units" },
      "fill": { "$type": "color", "$value": "#f5f5f5" },
      "rule": { "$type": "color", "$value": "#d9d9d9" },
      "pass": { "$type": "color", "$value": "#1f9d5b" },
      "warn": { "$type": "color", "$value": "#c77700" },
      "fail": { "$type": "color", "$value": "#c0392b" },
      "landing-bg": { "$type": "color", "$value": "#d9d9d9" },
      "landing-card": { "$type": "color", "$value": "#ffffff" }
    },
    "dark": {
      "ink": { "$type": "color", "$value": "#f2f2f2" },
      "surface": { "$type": "color", "$value": "#0e0e0e" },
      "tint": { "$type": "color", "$value": "#1c1c1e" },
      "hairline": { "$type": "color", "$value": "#2c2c2e" },
      "muted": { "$type": "color", "$value": "#8b8f94" },
      "accent": { "$type": "color", "$value": "#9b7ce8" },
      "accent-soft": { "$type": "color", "$value": "rgba(155, 124, 232, 0.22)" },
      "accent-faint": { "$type": "color", "$value": "rgba(155, 124, 232, 0.12)" },
      "secondary": { "$type": "color", "$value": "#b4b8bc" },
      "tertiary": { "$type": "color", "$value": "#8b8f94" },
      "fill": { "$type": "color", "$value": "#17171a" },
      "rule": { "$type": "color", "$value": "#2c2c2e" },
      "pass": { "$type": "color", "$value": "#34d399" },
      "warn": { "$type": "color", "$value": "#fbbf24" },
      "fail": { "$type": "color", "$value": "#f87171" },
      "landing-bg": { "$type": "color", "$value": "#000000" },
      "landing-card": { "$type": "color", "$value": "#1a1a1d" }
    },
    "fixed": {
      "white": { "$type": "color", "$value": "#ffffff" },
      "black": { "$type": "color", "$value": "#000000" },
      "night": { "$type": "color", "$value": "#090909", "$description": "Text on white CTA pills over dark gradients" },
      "cta-base": { "$type": "color", "$value": "#0a0a0f" },
      "pulse-violet-900": { "$type": "color", "$value": "#6d28d9" },
      "pulse-violet-500": { "$type": "color", "$value": "#8b5cf6" },
      "pulse-violet-200": { "$type": "color", "$value": "#c4b5fd" },
      "promo-glow": { "$type": "color", "$value": "rgba(147, 90, 255, 0.55)" },
      "table-head-stop-2": { "$type": "color", "$value": "#4a3a8f" },
      "table-head-stop-3": { "$type": "color", "$value": "#1a1430" }
    },
    "severity": {
      "critical": { "$type": "color", "$value": "#dc2626" },
      "high": { "$type": "color", "$value": "#ea580c" },
      "medium": { "$type": "color", "$value": "#f59e0b" },
      "low": { "$type": "color", "$value": "#6b7280" },
      "suggestion": { "$type": "color", "$value": "#0891b2" }
    }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Manrope", "system-ui", "sans-serif"] },
      "serif": { "$type": "fontFamily", "$value": ["Libre Baskerville", "Georgia", "serif"] }
    },
    "weight": {
      "light": { "$type": "fontWeight", "$value": 300 },
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    }
  },
  "typography": {
    "hero": { "$type": "typography", "$value": { "fontFamily": "{font.family.serif}", "fontStyle": "italic", "fontWeight": 400, "fontSize": "48px", "lineHeight": 1.25 }, "$description": "30px <640, 36px <768, 48px ≥768" },
    "message": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 400, "fontSize": "16px", "lineHeight": 1.625 } },
    "ui": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 400, "fontSize": "14px", "lineHeight": "20px" } },
    "caption": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 400, "fontSize": "12px", "lineHeight": "16px" } },
    "label-caps": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 400, "fontSize": "12px", "lineHeight": "16px", "letterSpacing": "0.025em", "textTransform": "uppercase" } },
    "card-display": { "$type": "typography", "$value": { "fontFamily": "{font.family.serif}", "fontStyle": "italic", "fontWeight": 400, "fontSize": "20px", "lineHeight": 1.375 } },
    "logo": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "20px", "letterSpacing": "-0.025em" }, "$description": "'reload' 400 + 'ux' 700; 18px in the app header" },
    "report-title": { "$type": "typography", "$value": { "fontFamily": "{font.family.serif}", "fontWeight": 700, "fontSize": "48px", "lineHeight": 1.02, "letterSpacing": "-0.02em" } },
    "report-h2": { "$type": "typography", "$value": { "fontFamily": "{font.family.serif}", "fontWeight": 700, "fontSize": "34px", "lineHeight": 1.1, "letterSpacing": "-0.02em" } },
    "report-h3": { "$type": "typography", "$value": { "fontFamily": "{font.family.serif}", "fontWeight": 700, "fontSize": "24px", "lineHeight": "32px", "letterSpacing": "-0.02em" } },
    "report-stat": { "$type": "typography", "$value": { "fontFamily": "{font.family.serif}", "fontWeight": 700, "fontSize": "46px", "lineHeight": 1, "letterSpacing": "-0.02em" } },
    "report-body": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 400, "fontSize": "14px", "lineHeight": 1.65 } },
    "report-cell": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 400, "fontSize": "13px", "lineHeight": 1.5 } },
    "report-finding": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 400, "fontSize": "12.5px", "lineHeight": 1.55 } },
    "report-finding-title": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 700, "fontSize": "15px" } },
    "report-eyebrow": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 700, "fontSize": "11px", "letterSpacing": "0.16em", "textTransform": "uppercase" } },
    "report-th": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 700, "fontSize": "10px", "letterSpacing": "0.1em", "textTransform": "uppercase" } },
    "report-chip": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 700, "fontSize": "9.5px", "letterSpacing": "0.08em", "textTransform": "uppercase" } }
  },
  "radius": {
    "md": { "$type": "dimension", "$value": "6px" },
    "lg": { "$type": "dimension", "$value": "8px" },
    "xl": { "$type": "dimension", "$value": "12px" },
    "2xl": { "$type": "dimension", "$value": "16px" },
    "3xl": { "$type": "dimension", "$value": "24px" },
    "full": { "$type": "dimension", "$value": "9999px" },
    "document": { "$type": "dimension", "$value": "0px" }
  },
  "shadow": {
    "soft": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "4px", "blur": "28px", "spread": "0px", "color": "rgba(0, 0, 0, 0.06)" } },
    "soft-lg": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "8px", "blur": "40px", "spread": "0px", "color": "rgba(0, 0, 0, 0.08)" } }
  },
  "size": {
    "gutter": { "$type": "dimension", "$value": "24px" },
    "thread-column": { "$type": "dimension", "$value": "840px" },
    "user-bubble-max": { "$type": "dimension", "$value": "720px" },
    "composer-max": { "$type": "dimension", "$value": "705.6px" },
    "avatar": { "$type": "dimension", "$value": "32px" },
    "avatar-indent": { "$type": "dimension", "$value": "44px" },
    "landing-container": { "$type": "dimension", "$value": "1152px" },
    "hero-column": { "$type": "dimension", "$value": "672px" }
  },
  "motion": {
    "ease": { "$type": "cubicBezier", "$value": [0.22, 1, 0.36, 1] },
    "duration-fast": { "$type": "duration", "$value": "150ms" },
    "duration-quick": { "$type": "duration", "$value": "200ms" },
    "duration-base": { "$type": "duration", "$value": "300ms" },
    "duration-enter": { "$type": "duration", "$value": "350ms" },
    "duration-slow": { "$type": "duration", "$value": "500ms" }
  }
}
