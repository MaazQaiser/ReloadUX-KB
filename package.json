{
  "name": "reloadux-kb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:indexes": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/create-indexes.ts",
    "db:local": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/db-local.ts",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed/index.ts",
    "e2e:server": "tsx --conditions=react-server scripts/e2e-server.ts",
    "auth:emulator": "tsx scripts/auth-emulator.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "lucide-react": "^1.54.0",
    "mongodb": "7.7.0",
    "next": "16.4.3",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "firebase-tools": "15.33.0",
    "mongodb-memory-server": "11.3.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@10.33.0"
}
