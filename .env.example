# Copy to .env.local and fill in. Never commit .env.local.

# PostgreSQL (with pgvector). `pnpm db:local` starts one in Docker on port 5433;
# `pnpm db:migrate` creates the tables. pglite:<dir> runs an in-process database instead.
DATABASE_URL=postgres://reloadux:reloadux@127.0.0.1:5433/reloadux

# Optional: debug | info | warn | error (default info).
LOG_LEVEL=info

# --- Sign-in (Firebase Authentication, Google provider) ---
# Leave all of these unset and the app stays locked with a "sign-in isn't set up" message.
# Firebase console > Project settings > General > Your apps > Web app config:
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<project-id>
# Firebase console > Project settings > Service accounts > Generate new private key.
# Server only. Paste the key on one line with \n for line breaks, in double quotes.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Comma-separated; these people become admins when they sign in.
INITIAL_ADMIN_EMAILS=
# Local testing only: point sign-in at the Firebase Auth Emulator instead of Google.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- AI and storage (each screen shows "not connected" until these are set) ---
# console.anthropic.com > API keys: the Ask agent, admin chat, Fill from text, captions.
ANTHROPIC_API_KEY=
# dash.voyageai.com > API keys: embeddings and reranking.
VOYAGE_API_KEY=
# Cloudflare dashboard > R2: screenshot storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
