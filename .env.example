# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# Database name; use a separate one per environment, e.g. reloadux_dev.
MONGODB_DB=reloadux_dev

# Optional: debug | info | warn | error (default info).
LOG_LEVEL=info
